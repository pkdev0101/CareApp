<?xml version="1.0" encoding="utf-8"?>
<!-- CareAnchor Senior-Accessible Color Palette -->
<!-- All colors WCAG AAA compliant for seniors 65+ -->
<resources>
    <!-- Primary - Green (Trust, Health, Actions) -->
    <color name="primary_green_dark">#FF1B5E20</color>
    <color name="primary_green_light">#FF4CAF50</color>
    <color name="primary_green_very_light">#FFE8F5E9</color>

    <!-- Secondary - Blue (Information, Safety) -->
    <color name="secondary_blue_dark">#FF0D47A1</color>
    <color name="secondary_blue_light">#FF1976D2</color>
    <color name="secondary_blue_lighter">#FFE3F2FD</color>

    <!-- Accent - Orange (Warnings, Reminders) -->
    <color name="accent_orange_dark">#FFE65100</color>
    <color name="accent_orange_light">#FFF57C00</color>
    <color name="accent_orange_lighter">#FFFFF3E0</color>

    <!-- Danger - Red (Emergency, Critical) -->
    <color name="danger_red_dark">#FF7F0000</color>
    <color name="danger_red_bright">#FFC62828</color>
    <color name="danger_red_light">#FFFFEBEE</color>

    <!-- Grayscale - High Contrast Neutrals -->
    <color name="text_dark">#FF212121</color>
    <color name="text_gray">#FF424242</color>
    <color name="text_light_gray">#FF757575</color>
    <color name="background_light">#FFFAFAFA</color>
    <color name="background_medium">#FFF5F5F5</color>
    <color name="border_gray">#FFBDBDBD</color>

    <!-- Status Colors -->
    <color name="success_green">#FF2E7D32</color>
    <color name="warning_yellow">#FFF9A825</color>
    <color name="error_red">#FFC62828</color>
    <color name="info_blue">#FF1565C0</color>

    <!-- Basics -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
</resources>
